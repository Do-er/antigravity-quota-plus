{
  "name": "antigravity-quota-plus",
  "displayName": "Antigravity Quota Plus",
  "description": "Monitor dual AI model quotas (5-Hour & Weekly limits) for Antigravity in the status bar",
  "version": "1.0.2",
  "publisher": "Doer",
  "icon": "assets/AntiGravityQuota.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./export/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agq.refresh",
        "title": "AGQ: Refresh Now"
      },
      {
        "command": "agq.reconnect",
        "title": "AGQ: Reconnect"
      },
      {
        "command": "agq.show_logs",
        "title": "AGQ: Show Debug Log"
      }
    ],
    "configuration": {
      "title": "AGQ",
      "properties": {
        "agq.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable auto monitoring",
          "order": 1
        },
        "agq.pollingInterval": {
          "type": "number",
          "default": 120,
          "minimum": 30,
          "description": "Polling interval in seconds (minimum: 30s, recommended: 120s+)",
          "order": 2
        },
        "agq.pinnedBuckets": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Quota bucket IDs to display in the status bar (e.g. 'gemini-5h', 'gemini-weekly', '3p-5h', '3p-weekly'). If empty, shows all available buckets.",
          "order": 3
        }
      }
    }
  },
  "scripts": {
    "node:vsix:package": "npm run compile && npx vsce package --baseImagesUrl https://raw.githubusercontent.com/Do-er/antigravity-quota-plus/main --baseContentUrl https://github.com/Do-er/antigravity-quota-plus/blob/main --no-git-tag-version",
    "bunx:vsix:package": "bun run compile && bunx vsce package --no-dependencies",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/vsce": "3.7.1",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/Do-er/antigravity-quota-plus.git"
  },
  "homepage": "https://github.com/Do-er/antigravity-quota-plus#readme",
  "bugs": {
    "url": "https://github.com/Do-er/antigravity-quota-plus/issues"
  },
  "keywords": [
    "antigravity",
    "quota",
    "ai"
  ],
  "author": "Doer",
  "license": "MIT"
}